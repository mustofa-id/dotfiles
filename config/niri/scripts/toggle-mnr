#!/usr/bin/env bash

set -euo pipefail

RAW="alsa_input.pci-0000_00_1f.3.analog-stereo"
CLEAN="rnnoise_microphone"
BETTER="deepfilter_microphone"

current="$(pactl get-default-source)"

case "$current" in
    "$CLEAN")  target="$BETTER"; message="DeepFilter ON";  detail="Best quality, higher CPU" ;;
    "$BETTER") target="$RAW";    message="Noise cancellation OFF"; detail="Using raw microphone" ;;
    *)         target="$CLEAN";  message="RNNoise ON";    detail="Lightweight, lower CPU" ;;
esac

if ! pactl list short sources | awk '{print $2}' | grep -Fxq "$target"; then
    notify-send -u critical "Microphone toggle failed" \
        "Source not found: $target"
    exit 1
fi

if pactl set-default-source "$target"; then
    notify-send -a "Microphone" -i "audio-input-microphone" \
        "$message" "$detail"
else
    notify-send -u critical "Microphone toggle failed" \
        "Could not change the default source"
    exit 1
fi
