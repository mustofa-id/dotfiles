{
	"update.mode": "manual",
	"extensions.autoUpdate": "off",
	"explorer.autoReveal": "focusNoScroll",
	"diffEditor.hideUnchangedRegions.enabled": true,
	"diffEditor.ignoreTrimWhitespace": false,
	"chat.disableAIFeatures": true,
	"svelte.enable-ts-plugin": true,
	"eslint.format.enable": true,
	"prettier.useTabs": true,
	"remote.autoForwardPortsSource": "hybrid",
	"cSpell.language": "en,id-id",
	"cSpell.customDictionaries": {
		"custom-dictionary-user": {
			"name": "custom-dictionary-user",
			"path": "~/.cspell/custom-dictionary-user.txt",
			"addWords": true,
			"scope": "user",
		},
		"project-words": {
			"name": "project-words",
			"path": "${workspaceRoot}/words.txt",
			"description": "Words used in this project",
			"addWords": true,
			"scope": "workspace",
		},
	},

	"window.autoDetectColorScheme": true,
	"window.restoreWindows": "none",
	"window.confirmBeforeClose": "always",
	"window.titleBarStyle": "native",
	"window.dialogStyle": "native",
	"window.customTitleBarVisibility": "never",
	"workbench.panel.defaultLocation": "right",
	"workbench.activityBar.location": "top",
	"workbench.tree.indent": 16,
	"workbench.startupEditor": "none",
	"workbench.editor.showTabs": "single",
	"workbench.panel.showLabels": false,
	"workbench.editorAssociations": {
		"*.svg": "default",
		"*.md": "vscode.markdown.preview.editor",
	},
	"workbench.editor.customLabels.patterns": {
		"**/routes/**/+{page,layout,error,server}.{svelte,js,ts,server.ts,server.js}": "${dirname}/${filename}.${extname}",
	},
	"workbench.colorCustomizations": {
		"[Vitesse Dark]": {
			"editor.background": "#000",
			"editorStickyScroll.background": "#000",
			"editor.lineHighlightBackground": "#0b390580",
			"editor.wordHighlightBackground": "#8d438da4",
			"editor.selectionHighlightBackground": "#61d5b26a",
			"editor.selectionBackground": "#8d734350",
			"panel.background": "#000",
			"sideBar.background": "#000",
			"list.activeSelectionBackground": "#237e19b1",
			"list.inactiveSelectionBackground": "#31682a65",
			"list.hoverBackground": "#357c2c4a",
			"quickInputList.focusBackground": "#357c2c92",
			"editorGroup.emptyBackground": "#111",
			"activityBarTop.background": "#000",
			"editorGroupHeader.noTabsBackground": "#000",
			"statusBar.background": "#000",
			"titleBar.activeBackground": "#000",
		},
	},
	"editor.fontFamily": "'Cascadia Code', 'Symbols Nerd Font', monospace",
	"editor.fontWeight": "450",
	"editor.fontLigatures": true,
	"editor.fontSize": 13,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.enabled": false,
	"editor.cursorStyle": "line-thin",
	"editor.cursorBlinking": "smooth",
	"editor.letterSpacing": 0,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.bracketPairColorization.enabled": true,
	"editor.guides.bracketPairs": "active",
	"editor.insertSpaces": false,
	"editor.formatOnSave": true,
	"editor.formatOnSaveMode": "file",
	// "editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit",
	},
	"editor.tokenColorCustomizations": {
		"[Vitesse Dark]": {
			"strings": "#bcaf95",
			"variables": "#e7b578",
		},
	},

	"terminal.external.windowsExec": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.lineHeight": 1,
	"terminal.integrated.suggest.selectionMode": "never",
	"terminal.integrated.suggest.enabled": false,

	"markdown.preview.fontSize": 18,
	"markdown.preview.lineHeight": 1.5,

	"[dockerfile][dockercompose]": {
		"editor.defaultFormatter": "ms-azuretools.vscode-docker",
	},
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer",
	},
	"[svelte]": {
		"editor.defaultFormatter": "svelte.svelte-vscode",
	},
	"[typescriptreact][javascript][typescript][json][jsonc][html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"[markdown]": {
		"diffEditor.ignoreTrimWhitespace": true,
	},
	"remote.SSH.remotePlatform": {
		"mstf-hs": "linux",
	},
	"[vue]": {
		"editor.defaultFormatter": "Vue.volar",
	},
	"terminal.integrated.initialHint": false,
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
	},
	"window.menuBarVisibility": "toggle",
	"json.schemaDownload.trustedDomains": {
		"https://developer.microsoft.com/json-schemas/": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://models.dev/model-schema.json": true,
		"https://opencode.ai/config.json": true,
		"https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/lint-rules.v1.json": true,
		"https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/lint-tags.v1.json": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://spec.openapis.org/": true,
		"https://ui.shadcn.com/schema.json": true,
		"https://unpkg.com/%40changesets/config%404.0.1/schema.json": true,
		"https://www.schemastore.org/": true,
	},
	"python.analysis.typeCheckingMode": "strict",
	"dev.containers.dockerComposePath": "podman-compose",
	"dev.containers.dockerPath": "podman",
	"terminal.external.linuxExec": "foot",
	"[typescript]": {},
	"workbench.preferredDarkColorTheme": "Vitesse Black",
}
